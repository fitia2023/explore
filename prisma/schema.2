generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id_utilisateur    Int      @id @default(autoincrement())
  nom               String
  prenom            String
  mail              String   @unique
  mot_de_passe      String
  date_de_naissance DateTime
  tel               String
  token             String?

  destinations_realiser destination_fait[]
  items_possession      cocher[]
  Commentaire           Commentaire[]
}

model Destination {
  id_destination    Int     @id @default(autoincrement())
  pays              String
  region            String?
  description       String
  avis_global       Float
  climat           String?
  image             String
  meilleure_periode String?
  tags              String?

  commentaires     Commentaire[]
  activites        Activite[]
  checklist_items  contient[]
  formalites       requiert[]
  destination_fait destination_fait[]
  conseils_eco     conseil_eco[]
}

model Commentaire {
  id_commentaire           Int      @id @default(autoincrement())
  note                     Int
  contenu                  String
  date_commentaire         DateTime
  image_commentaire        String?

  utilisateurId_utilisateur Int
  destinationId_destination Int

  autheur              Utilisateur @relation(fields: [utilisateurId_utilisateur], references: [id_utilisateur])
  destination_concerne Destination @relation(fields: [destinationId_destination], references: [id_destination])
}

model Activite {
  id_activite          Int     @id @default(autoincrement())
  nom_activite         String
  description_activite String
  image_activite       String?

  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id_destination])
}

model Contact {
  id_contact  Int      @id @default(autoincrement())
  nom         String
  prenom      String
  mail        String
  message     String
  date_envoie DateTime
}

model CheckListe_Item {
  id_checkliste_item Int    @id @default(autoincrement())
  nom_item           String

  cocheurs    cocher[]
  destinations contient[]
}

model Formalite_administrative_Item {
  id_formalite_administrative_item Int    @id @default(autoincrement())
  descripition_formalite           String

  destinations requiert[]
}

model EcoSuggestion {
  id_eco_suggestion Int @id @default(autoincrement())
  titre             String
  description       String
  impact            String
  categorie         String

  destinations conseil_eco[]
}

model destination_fait {
  utilisateurId Int
  destinationId Int

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id_utilisateur])
  destination Destination @relation(fields: [destinationId], references: [id_destination])

  @@id([utilisateurId, destinationId])
}

model contient {
  destinationId   Int
  checklistItemId Int

  destination    Destination     @relation(fields: [destinationId], references: [id_destination])
  checklist_item CheckListe_Item @relation(fields: [checklistItemId], references: [id_checkliste_item])

  @@id([destinationId, checklistItemId])
}

model requiert {
  destinationId   Int
  formaliteItemId Int

  destination Destination                   @relation(fields: [destinationId], references: [id_destination])
  formalite   Formalite_administrative_Item @relation(fields: [formaliteItemId], references: [id_formalite_administrative_item])

  @@id([destinationId, formaliteItemId])
}

model cocher {
  utilisateurId   Int
  checklistItemId Int
  date_cocher     DateTime

  utilisateur    Utilisateur     @relation(fields: [utilisateurId], references: [id_utilisateur])
  checklist_item CheckListe_Item @relation(fields: [checklistItemId], references: [id_checkliste_item])

  @@id([utilisateurId, checklistItemId])
}

model conseil_eco {
  destinationId    Int
  ecoSuggestionId  Int

  destination    Destination   @relation(fields: [destinationId], references: [id_destination])
  ecoSuggestion  EcoSuggestion @relation(fields: [ecoSuggestionId], references: [id_eco_suggestion])

  @@id([destinationId, ecoSuggestionId])
}
